# Django
DEBUG=1
SECRET_KEY=change-me-in-production-super-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,web

# LLM / RAG
LLM_PROVIDER=ollama          # ollama | openai | groq | anthropic etc.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2        # or deepseek-r1, qwen2.5, etc.
OPENAI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3  # or nomic-embed-text, text-embedding-3-large

# Vector store
VECTOR_STORE=chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000

# Django DB (switch to postgres later)
DATABASE_URL=sqlite:///db.sqlite3

# Optional: Ingestion
JORADP_BASE=https://www.joradp.dz
